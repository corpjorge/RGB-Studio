<Window x:Class="RgbStudio.CalibrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Calibracion de color" Height="430" Width="430"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="#1E1E24" Foreground="#E8E8EC"
        FontFamily="Segoe UI" ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E8E8EC"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#E8E8EC"/>
            <Setter Property="CaretBrush" Value="#E8E8EC"/>
            <Setter Property="Background" Value="#25252D"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="9,7"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#33333D"/>
            <Setter Property="Foreground" Value="#E8E8EC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="13,8"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="CALIBRACION DEL DISPOSITIVO" FontSize="11"
                       Foreground="#8A8A96" FontWeight="SemiBold"/>
            <TextBlock x:Name="DeviceName" FontSize="16" FontWeight="SemiBold"
                       TextWrapping="Wrap" Margin="0,5,0,6"/>
            <TextBlock Text="Ganancia ajusta la intensidad. Gamma mayor reduce valores bajos sin alterar cero ni el maximo."
                       Foreground="#8A8A96" FontSize="11" TextWrapping="Wrap"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,18,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Column="1" Text="Ganancia %" Foreground="#8A8A96" Margin="2,0,8,6"/>
            <TextBlock Grid.Column="2" Text="Gamma" Foreground="#8A8A96" Margin="2,0,0,6"/>

            <TextBlock Grid.Row="1" Text="R" VerticalAlignment="Center"/>
            <TextBox Grid.Row="1" Grid.Column="1" x:Name="RedGainBox" Margin="0,0,8,7"/>
            <TextBox Grid.Row="1" Grid.Column="2" x:Name="RedGammaBox" Margin="0,0,0,7"/>

            <TextBlock Grid.Row="2" Text="G" VerticalAlignment="Center"/>
            <TextBox Grid.Row="2" Grid.Column="1" x:Name="GreenGainBox" Margin="0,0,8,7"/>
            <TextBox Grid.Row="2" Grid.Column="2" x:Name="GreenGammaBox" Margin="0,0,0,7"/>

            <TextBlock Grid.Row="3" Text="B" VerticalAlignment="Center"/>
            <TextBox Grid.Row="3" Grid.Column="1" x:Name="BlueGainBox" Margin="0,0,8,0"/>
            <TextBox Grid.Row="3" Grid.Column="2" x:Name="BlueGammaBox"/>
        </Grid>

        <TextBlock Grid.Row="2" x:Name="Validation" Foreground="#FF7A18"
                   FontSize="11" TextWrapping="Wrap"/>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Neutro" Click="OnNeutral" Margin="0,0,7,0"/>
            <Button Grid.Column="1" Content="Inicial" Click="OnInitial"/>
            <Button Grid.Column="3" Content="Cancelar" Click="OnCancel" Margin="0,0,7,0"/>
            <Button Grid.Column="4" Content="Guardar y probar" Click="OnSave"
                    Background="#FF7A18" Foreground="#14140F" FontWeight="SemiBold"/>
        </Grid>
    </Grid>
</Window>
